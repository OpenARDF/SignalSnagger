* text=auto

# Keep source, documentation, and CAD text consistent across platforms.
/.editorconfig text eol=lf
/.gitattributes text eol=lf
/.gitignore text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.xml text eol=lf
*.html text eol=lf
*.csv -text
*.pos text eol=lf
*.rpt text eol=lf
*.dox text eol=lf
*.rst text eol=lf
*.h text eol=lf
*.c text eol=lf
*.cpp text eol=lf
*.S text eol=lf
*.sh text eol=lf
Justfile text eol=lf

# Dormant legacy import has mixed historical line endings; retain it byte-for-byte.
Software/AVR128DA48/SignalSnagger/src/linkbus.cpp -text
*.kicad_sch text eol=lf
*.kicad_pcb text eol=lf
*.kicad_pro text eol=lf
*.kicad_prl text eol=lf
*.kicad_sym text eol=lf
*.kicad_mod text eol=lf
*.gbr text eol=lf
*.gbrjob text eol=lf
*.drl text eol=lf
*.ipc text eol=lf
*.pretty/** text eol=lf

# Preserve Windows-native line endings for Microchip Studio files.
*.ps1 text eol=crlf
*.sln text eol=crlf
*.cppproj text eol=crlf
*.componentinfo.xml text eol=crlf

# Intel HEX, EEPROM, and S-record files are reviewable ASCII records.
*.hex text eol=lf
*.eep text eol=lf
*.srec text eol=lf

# Binary design and compiler artifacts.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.pdf binary
*.zip binary
*.xlsx binary
*.numbers binary
*.step binary
*.FCStd binary
*.atsuo binary
*.elf binary
